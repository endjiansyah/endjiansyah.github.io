---
import StoryDetail from '../../components/pages/StoryDetail.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const stories = (await getCollection('stories')).filter((s) => s.data.lang === 'id');
  return stories.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<StoryDetail entry={entry} />
