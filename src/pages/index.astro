<script>
  // Show/Hide Detail: toggle panel detail tiap item timeline.
  // Klik "Show Detail" -> tampilkan detail & label jadi "Hide Detail", klik lagi -> sembunyikan.
  document.querySelectorAll<HTMLElement>('.detail-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = btn.parentElement?.querySelector<HTMLElement>('.timeline-detail');
      if (!panel) return;
      const isHidden = panel.classList.toggle('hidden');
      const label = btn.querySelector('.detail-toggle-label');
      if (label) label.textContent = isHidden ? 'Show Detail' : 'Hide Detail';
      btn.setAttribute('aria-expanded', String(!isHidden));
      // Rotasi chevron saat terbuka
      btn.querySelector('svg')?.classList.toggle('rotate-180', !isHidden);
    });
  });

  // Load more education: tampilkan kartu yang tersembunyi (sisa dari INITIAL_EDU_COUNT),
  // lalu sembunyikan tombolnya. Pola vanilla JS, konsisten dengan BaseLayout/Navbar.
  const loadMoreBtn = document.getElementById('education-load-more');

  loadMoreBtn?.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('.education-item').forEach((item) => {
      if (item.style.display === 'none') item.style.display = '';
    });
    // Bungkus tombol (div tengah) ikut dihapus agar tidak menyisakan ruang kosong
    loadMoreBtn.parentElement?.remove();
  });
</script>
