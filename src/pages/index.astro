---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WorkCard from '../components/WorkCard.astro';
import StoryCard from '../components/StoryCard.astro';
import EducationCard from '../components/EducationCard.astro';
import { getCollection } from 'astro:content';

// Fetch content collections
const allWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const allStories = (await getCollection('stories')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Education: playlists + modules
const eduPlaylists = await getCollection('playlists');
const moduleFiles = import.meta.glob('../content/modules/*.md', { eager: true });
const eduModules = Object.keys(moduleFiles).length > 0 ? await getCollection('modules') : [];
const allEducation = [
  ...eduPlaylists.map((p) => ({ ...p, kind: 'video' as const })),
  ...eduModules.map((m) => ({ ...m, kind: 'module' as const })),
].sort((a, b) => a.data.order - b.data.order);
const INITIAL_EDU_COUNT = 6;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Endjiansyah",
  "alternateName": "Endji Ansyah",
  "url": "https://endjiansyah.github.io",
  "image": "https://endjiansyah.github.io/assets/profile.webp",
  "description": "Software Engineer, Product Manager & Educator",
  "jobTitle": "Product Manager / Engineering Manager",
  "worksFor": {
    "@type": "Organization",
    "name": "Alkademi"
  },
  "sameAs": [
    "https://github.com/endjiansyah",
    "https://www.linkedin.com/in/endji-ansyah-30322a115/"
  ]
};
---

<BaseLayout 
  title="Endjiansyah — Software Engineer, Product Manager & Educator"
  ogImage="/assets/profile.webp"
  jsonSchema={personSchema}
>
  <Navbar slot="nav" />

  <!-- ======================== -->
  <!-- Hero Section             -->
  <!-- ======================== -->
  <section id="hero" class="relative bg-[#0B132B] text-white min-h-[92vh] flex items-center px-6 sm:px-12 md:px-20 overflow-hidden bg-grid-pattern-dark">
    <!-- Ambient glowing light spots -->
    <div class="absolute top-1/4 right-10 w-[350px] h-[350px] sm:w-[650px] sm:h-[650px] bg-blue-600/15 rounded-full blur-[100px] sm:blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-10 left-10 w-[250px] h-[250px] sm:w-[500px] sm:h-[500px] bg-cyan-500/10 rounded-full blur-[80px] sm:blur-[120px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto relative z-10 flex flex-col md:flex-row justify-between items-center gap-12 md:gap-16 py-24 sm:py-32 w-full reveal reveal-up">
      <div class="flex-1 text-center md:text-left">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold tracking-wide text-blue-300 mb-8 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Software Engineer &bull; Product Manager &bull; Educator
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-4 leading-[1.08] font-display">
          Endjiansyah<span class="text-blue-500">.</span>
        </h1>
        <h2 class="text-lg md:text-xl text-blue-200/80 font-medium tracking-wide mb-6">
          Software Engineer &bull; Product Manager &bull; Educator
        </h2>
        <p class="text-base md:text-lg leading-relaxed text-slate-300/90 max-w-xl mx-auto md:mx-0 font-normal mb-10">
          Halo, saya Endjiansyah. Saya bekerja di bidang pengembangan aplikasi web, pengelolaan produk, serta aktif dalam edukasi teknologi—mulai dari mengelola alur pengembangan perangkat lunak hingga menyusun modul dan mengajar di Alkademi.
        </p>
        
        <div class="flex flex-wrap gap-4 text-sm font-semibold justify-center md:justify-start">
          <a href="mailto:endji1507@gmail.com" class="px-7 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-full transition-all duration-300 shadow-lg shadow-blue-600/30 hover:shadow-blue-500/50 flex items-center gap-2">
            Hubungi Saya
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
          <a href="https://github.com/endjiansyah" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-white/5 border border-white/15 rounded-full hover:bg-white/10 text-white transition-all">GitHub</a>
          <a href="https://www.linkedin.com/in/endji-ansyah-30322a115/" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-white/5 border border-white/15 rounded-full hover:bg-white/10 text-white transition-all">LinkedIn</a>
        </div>
      </div>
      
      <!-- Photo Avatar Frame -->
      <div class="flex-shrink-0 order-first md:order-last">
        <div class="relative group">
          <div class="absolute -inset-3 bg-gradient-to-r from-blue-500 to-cyan-400 rounded-full blur-2xl opacity-30 group-hover:opacity-60 transition duration-700"></div>
          <div class="relative w-56 h-56 lg:w-80 lg:h-80 rounded-full overflow-hidden border-4 border-white/15 shadow-2xl transition-all duration-500 hover:border-blue-400/50 z-10">
            <img src="/assets/profile.webp" alt="Endjiansyah" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ======================== -->
  <!-- Section: The Journey     -->
  <!-- ======================== -->
  <section id="journey" class="py-24 sm:py-32 bg-[#F8FAFC] relative bg-grid-pattern">
    <div class="max-w-6xl mx-auto px-6 sm:px-12 md:px-20 relative reveal reveal-up">
      <!-- Section Header -->
      <div class="mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-50 px-3.5 py-1 rounded-full border border-blue-200/60 inline-block mb-3">
          Pengalaman & Perjalanan
        </span>
        <h3 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight font-display">The Journey</h3>
        <p class="text-gray-600 text-base sm:text-lg max-w-2xl mt-2 leading-relaxed font-normal">
          Perjalanan karir dari fondasi pemrograman web, eksekusi produk, hingga manajemen tim rekayasa.
        </p>
      </div>

      <!-- Split Grid Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        
        <!-- Column 1: Pengalaman Kerja -->
        <div class="bg-white p-8 sm:p-10 rounded-3xl border border-gray-200/80 shadow-sm">
          <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-2xl bg-blue-600/10 flex items-center justify-center text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div>
              <h4 class="text-2xl font-bold text-gray-900 tracking-tight">Pengalaman Kerja</h4>
              <p class="text-xs text-gray-400 font-medium uppercase tracking-wider">Rekam Jejak Profesional</p>
            </div>
          </div>

          <div class="relative border-l-2 border-blue-100 ml-4 space-y-10 py-2">
            
            <!-- Node: PM/EM -->
            <div class="relative pl-8 group">
              <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-blue-600 border-4 border-white rounded-full shadow-md group-hover:scale-125 transition-transform"></div>
              <div class="text-xs font-semibold text-blue-600 mb-1 tracking-wider uppercase">2024 — Present</div>
              <h5 class="text-lg font-bold text-gray-900 mb-1">Product Manager / Engineering Manager</h5>
              <span class="inline-block px-3 py-0.5 bg-blue-50 text-blue-700 font-medium text-xs mb-2.5 rounded-full border border-blue-100">Alkademi / inideku.id</span>
              <p class="text-gray-600 leading-relaxed text-sm">
                Memimpin penyelarasan strategi produk dan rekayasa tim. Menghubungkan kebutuhan bisnis dengan eksekusi arsitektur teknis secara efisien.
              </p>
            </div>

            <!-- Node: Web Dev -->
            <div class="relative pl-8 group">
              <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-blue-600 group-hover:scale-125 transition-all"></div>
              <div class="text-xs font-semibold text-gray-400 mb-1 tracking-wider uppercase">Jul 2023 — 2024</div>
              <h5 class="text-lg font-bold text-gray-900 mb-1">Web Developer</h5>
              <span class="inline-block px-3 py-0.5 bg-gray-50 border border-gray-200 text-gray-600 font-medium text-xs mb-2.5 rounded-full">inideku.id & Freelance</span>
              <p class="text-gray-600 leading-relaxed text-sm">
                Mengembangkan dan memelihara platform web berbasis TALL Stack dan integrasi ReactJS dengan fokus pada performa serta kemudahan pemeliharaan.
              </p>
            </div>

            <!-- Node: Backend -->
            <div class="relative pl-8 group">
              <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-blue-600 group-hover:scale-125 transition-all"></div>
              <div class="text-xs font-semibold text-gray-400 mb-1 tracking-wider uppercase">Mar 2023 — Jul 2023</div>
              <h5 class="text-lg font-bold text-gray-900 mb-1">Backend Developer</h5>
              <span class="inline-block px-3 py-0.5 bg-gray-50 border border-gray-200 text-gray-600 font-medium text-xs mb-2.5 rounded-full">CODELITE</span>
              <p class="text-gray-600 leading-relaxed text-sm">
                Merancang layanan backend dengan bahasa Go (Golang) untuk membangun pemrosesan data yang stabil dan andal.
              </p>
            </div>

            <!-- Node: Web Dev (Early) -->
            <div class="relative pl-8 group">
              <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-gray-500 group-hover:scale-125 transition-all"></div>
              <div class="text-xs font-semibold text-gray-400 mb-1 tracking-wider uppercase">Dec 2020 — Oct 2022</div>
              <h5 class="text-lg font-bold text-gray-900 mb-1">Freelance Web Developer</h5>
              <span class="inline-block px-3 py-0.5 bg-gray-50 border border-gray-200 text-gray-600 font-medium text-xs mb-2.5 rounded-full">Local Clients & SMB</span>
              <p class="text-gray-600 leading-relaxed text-sm">
                Membangun solusi sistem kustom MVC berbasis PHP, CodeIgniter, dan Bootstrap untuk berbagai klien lokal.
              </p>
            </div>

            <!-- Node: Internship -->
            <div class="relative pl-8 group">
              <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-gray-500 group-hover:scale-125 transition-all"></div>
              <div class="text-xs font-semibold text-gray-400 mb-1 tracking-wider uppercase">Dec 2019 — Feb 2020</div>
              <h5 class="text-lg font-bold text-gray-900 mb-1">Fullstack Intern</h5>
              <span class="inline-block px-3 py-0.5 bg-gray-50 border border-gray-200 text-gray-600 font-medium text-xs mb-2.5 rounded-full">Diskominfo Kab. Jepara</span>
              <p class="text-gray-600 leading-relaxed text-sm">
                Mengembangkan aplikasi pelaporan WBS (Whistleblowing System) sebagai pengalaman nyata pertama dalam sistem pemerintahan daerah.
              </p>
            </div>

          </div>
        </div>

        <!-- Column 2: Pendidikan & Pelatihan -->
        <div class="bg-white p-8 sm:p-10 rounded-3xl border border-gray-200/80 shadow-sm">
          <div class="flex items-center gap-4 mb-8">
            <div class="w-12 h-12 rounded-2xl bg-amber-600/10 flex items-center justify-center text-amber-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14v7"></path></svg>
            </div>
            <div>
              <h4 class="text-2xl font-bold text-gray-900 tracking-tight">Pendidikan & Pelatihan</h4>
              <p class="text-xs text-gray-400 font-medium uppercase tracking-wider">Fondasi Vokasi & Akademik</p>
            </div>
          </div>

          <div class="relative border-l-2 border-amber-100 ml-4 space-y-10 py-2">
            
            <!-- Node: Bootcamp -->
            <div class="relative pl-8 group">
              <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-amber-500 border-4 border-white rounded-full shadow-md group-hover:scale-125 transition-transform"></div>
              <div class="text-xs font-semibold text-amber-600 mb-1 tracking-wider uppercase">Nov 2022 — Jan 2023</div>
              <h5 class="text-lg font-bold text-gray-900 mb-1">Bootcamp Scholarship</h5>
              <span class="inline-block px-3 py-0.5 bg-amber-50 text-amber-700 font-medium text-xs mb-2.5 rounded-full border border-amber-200/60">Alkademi — UMPTN Farcapital</span>
              <p class="text-gray-600 leading-relaxed text-sm">
                Pelatihan intensif *on-site* di Bandung. Pendalaman praktik rekayasa perangkat lunak modern, arsitektur Laravel, dan pengerjaan proyek OCR kolaboratif.
              </p>
            </div>

            <!-- Node: College -->
            <div class="relative pl-8 group">
              <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-amber-500 group-hover:scale-125 transition-all"></div>
              <div class="text-xs font-semibold text-gray-400 mb-1 tracking-wider uppercase">2018 — 2020</div>
              <h5 class="text-lg font-bold text-gray-900 mb-1">Pendidikan D2 Manajemen Informatika</h5>
              <span class="inline-block px-3 py-0.5 bg-gray-50 border border-gray-200 text-gray-600 font-medium text-xs mb-2.5 rounded-full">Politeknik Negeri Malang</span>
              <p class="text-gray-600 leading-relaxed text-sm">
                Mempelajari logika dasar pemrograman, perancangan basis data relasional, algoritma, serta metodologi pengembangan perangkat lunak.
              </p>
            </div>

            <!-- Node: High School -->
            <div class="relative pl-8 group">
              <div class="absolute -left-[9px] top-1.5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-gray-500 group-hover:scale-125 transition-all"></div>
              <div class="text-xs font-semibold text-gray-400 mb-1 tracking-wider uppercase">2015 — 2018</div>
              <h5 class="text-lg font-bold text-gray-900 mb-1">Teknik Komputer & Jaringan</h5>
              <span class="inline-block px-3 py-0.5 bg-gray-50 border border-gray-200 text-gray-600 font-medium text-xs mb-2.5 rounded-full">SMK Negeri 3 Jepara</span>
              <p class="text-gray-600 leading-relaxed text-sm">
                Pendidikan vokasi dasar infrastruktur TI, arsitektur *hardware*, topologi jaringan komputer, dan sistem operasi Linux.
              </p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ======================== -->
  <!-- Section: Selected Works  -->
  <!-- ======================== -->
  <section id="works" class="py-24 sm:py-32 bg-white relative">
    <div class="max-w-6xl mx-auto px-6 sm:px-12 md:px-20 reveal reveal-up">
      <!-- Section Header -->
      <div class="mb-14">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-50 px-3.5 py-1 rounded-full border border-blue-200/60 inline-block mb-3">
          Software Engineering Portfolio
        </span>
        <h3 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight font-display">Selected Works</h3>
        <p class="text-gray-600 text-base sm:text-lg max-w-2xl mt-2 leading-relaxed font-normal">
          Kumpulan proyek rekayasa perangkat lunak dan aplikasi web yang pernah saya rancang dan kembangkan.
        </p>
      </div>

      <!-- Uniform Grid Showcase -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {allWorks.map((work) => (
          <WorkCard
            title={work.data.title}
            description={work.data.description}
            coverImage={work.data.coverImage}
            tools={work.data.tools}
            slug={work.slug}
            liveUrl={work.data.liveUrl}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ======================== -->
  <!-- Section: Stories (Dark Break) -->
  <!-- ======================== -->
  <section id="stories" class="py-24 sm:py-32 bg-[#0B132B] text-white relative overflow-hidden bg-grid-pattern-dark">
    <!-- Ambient backdrop glow -->
    <div class="absolute top-1/3 left-0 w-[400px] h-[400px] bg-blue-600/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto px-6 sm:px-12 md:px-20 relative z-10 reveal reveal-up">
      <!-- Section Header -->
      <div class="mb-14">
        <span class="text-xs font-bold uppercase tracking-widest text-cyan-400 bg-cyan-950/60 px-3.5 py-1 rounded-full border border-cyan-800/60 inline-block mb-3">
          Field Notes & Insights
        </span>
        <h3 class="text-3xl sm:text-4xl font-bold text-white tracking-tight font-display">Stories & Field Notes</h3>
        <p class="text-slate-300/80 text-base sm:text-lg max-w-2xl mt-2 leading-relaxed font-normal">
          Studi kasus lapangan, refleksi perjalanan profesional, dan inisiatif berdampak di dunia teknologi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allStories.map((story) => (
          <StoryCard
            title={story.data.title}
            description={story.data.description}
            coverImage={story.data.coverImage}
            type={story.data.type}
            tags={story.data.tags}
            slug={story.slug}
            date={story.data.date}
            endDate={story.data.endDate}
            dateLabel={story.data.dateLabel}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ======================== -->
  <!-- Section: Learning        -->
  <!-- ======================== -->
  {allEducation.length > 0 && (
    <section id="learning" class="py-24 sm:py-32 bg-[#F8FAFC] relative bg-grid-pattern">
      <div class="max-w-6xl mx-auto px-6 sm:px-12 md:px-20 relative reveal reveal-up">
        <!-- Section Header -->
        <div class="mb-14">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 bg-emerald-50 px-3.5 py-1 rounded-full border border-emerald-200/60 inline-block mb-3">
            Authored Learning Modules
          </span>
          <h3 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight font-display">Learning & Modules</h3>
          <p class="text-gray-600 text-base sm:text-lg max-w-2xl mt-2 leading-relaxed font-normal">
            Kumpulan modul bacaan dan seri video pembelajaran yang saya susun dan kembangkan sendiri secara terstruktur.
          </p>
        </div>

        <div id="education-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {allEducation.map((item, i) => (
            <div class="education-item" data-index={i} style={i >= INITIAL_EDU_COUNT ? 'display:none;' : undefined}>
              <EducationCard
                title={item.data.title}
                description={item.data.description}
                coverImage={item.data.coverImage}
                kind={item.kind}
                slug={item.slug}
                tags={item.data.tags}
                videoCount={item.kind === 'video' ? item.data.videos.length : undefined}
                readTime={item.kind === 'module' ? item.data.readTime : undefined}
                date={item.data.date}
              />
            </div>
          ))}
        </div>

        {allEducation.length > INITIAL_EDU_COUNT && (
          <div class="mt-14 text-center">
            <button
              id="education-load-more"
              type="button"
              class="inline-flex items-center gap-2.5 px-8 py-3.5 bg-blue-600 hover:bg-blue-500 text-white rounded-full text-sm font-semibold transition-all duration-300 shadow-md hover:shadow-lg"
            >
              Muat Lebih Banyak
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
            </button>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ======================== -->
  <!-- Section: Contact CTA     -->
  <!-- ======================== -->
  <section id="contact" class="py-24 bg-[#0B132B] text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern-dark opacity-40"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] h-[350px] sm:w-[700px] sm:h-[700px] bg-blue-600/15 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto px-6 sm:px-12 relative z-10 reveal reveal-up">
      <div class="bg-white/5 border border-white/10 rounded-3xl p-10 sm:p-16 text-center backdrop-blur-xl shadow-2xl">
        <h3 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-5 font-display">Mari Berkolaborasi</h3>
        <p class="text-slate-300/80 text-base sm:text-lg leading-relaxed mb-10 max-w-xl mx-auto font-normal">
          Punya gagasan proyek, peluang kepemimpinan teknis, atau sekadar ingin bertukar pikiran? Saya selalu terbuka untuk diskusi yang produktif.
        </p>
        <div class="flex flex-wrap gap-4 justify-center text-sm font-semibold">
          <a href="mailto:endji1507@gmail.com" class="px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white rounded-full transition-all duration-300 shadow-xl shadow-blue-600/30 hover:shadow-blue-500/50 flex items-center gap-2">
            Kirim Email
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
