---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WorkCard from '../components/WorkCard.astro';
import StoryCard from '../components/StoryCard.astro';
import EducationCard from '../components/EducationCard.astro';
import { getCollection } from 'astro:content';

// Fetch content collections
const allWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const allStories = (await getCollection('stories')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Education: playlists + modules
const eduPlaylists = await getCollection('playlists');
const moduleFiles = import.meta.glob('../content/modules/*.md', { eager: true });
const eduModules = Object.keys(moduleFiles).length > 0 ? await getCollection('modules') : [];
const allEducation = [
  ...eduPlaylists.map((p) => ({ ...p, kind: 'video' as const })),
  ...eduModules.map((m) => ({ ...m, kind: 'module' as const })),
].sort((a, b) => a.data.order - b.data.order);
const INITIAL_EDU_COUNT = 6;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://endjiansyah.github.io/#person",
  "name": "Endjiansyah",
  "alternateName": "Endji Ansyah",
  "url": "https://endjiansyah.github.io",
  // ImageObject lengkap: Google Images butuh dimensi + caption, bukan sekadar string URL.
  "image": {
    "@type": "ImageObject",
    "@id": "https://endjiansyah.github.io/#portrait",
    "url": "https://endjiansyah.github.io/assets/profile.webp",
    "contentUrl": "https://endjiansyah.github.io/assets/profile.webp",
    "width": 382,
    "height": 382,
    "caption": "Foto Endjiansyah, Software Engineer, AI-Augmented Developer & Technical Mentor",
    "name": "Endjiansyah",
    "encodingFormat": "image/webp",
    "representativeOfPage": true,
    "author": { "@id": "https://endjiansyah.github.io/#person" }
  },
  "description": "Software Engineer, AI-Augmented Developer & Technical Mentor",
  "jobTitle": "Software Engineer / Technical Mentor",
  "worksFor": {
    "@type": "Organization",
    "name": "Alkademi"
  },
  "sameAs": [
    "https://github.com/endjiansyah",
    "https://www.linkedin.com/in/endji-ansyah-30322a115/"
  ]
};
---

<BaseLayout 
  title="Endjiansyah — Software Engineer, AI-Augmented Developer & Technical Mentor"
  ogImage="/assets/profile.webp"
  jsonSchema={personSchema}
>
  <Navbar slot="nav" />

  <!-- ======================== -->
  <!-- Hero Section             -->
  <!-- ======================== -->
  <section id="hero" class="relative bg-[#0B132B] text-white min-h-[92vh] flex items-center px-6 sm:px-12 md:px-20 overflow-hidden bg-grid-pattern-dark">
    <!-- Ambient glowing light spots -->
    <div class="absolute top-1/4 right-10 w-[350px] h-[350px] sm:w-[650px] sm:h-[650px] bg-blue-600/15 rounded-full blur-[100px] sm:blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-10 left-10 w-[250px] h-[250px] sm:w-[500px] sm:h-[500px] bg-cyan-500/10 rounded-full blur-[80px] sm:blur-[120px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto relative z-10 flex flex-col md:flex-row justify-between items-center gap-12 md:gap-16 py-24 sm:py-32 w-full reveal reveal-up">
      <div class="flex-1 text-center md:text-left">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold tracking-wide text-blue-300 mb-8 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Software Engineer &bull; AI-Augmented Developer &bull; Technical Mentor
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-4 leading-[1.08] font-display">
          Endjiansyah<span class="text-blue-500">.</span>
        </h1>
        <h2 class="text-lg md:text-xl text-blue-200/80 font-medium tracking-wide mb-6">
          Software Engineer &bull; AI-Augmented Developer &bull; Technical Mentor
        </h2>
        <p class="text-base md:text-lg leading-relaxed text-slate-300/90 max-w-xl mx-auto md:mx-0 font-normal mb-10">
          Halo, saya Endjiansyah. Saya seorang Software Engineer, AI-Augmented Developer, dan Educator di Alkademi. Saya berfokus pada pengembangan aplikasi web skala penuh, pengelolaan sistem edukasi digital, serta pembimbingan teknis (Technical Mentorship) pada berbagai program kolaborasi edukasi dan sosial nasional.
        </p>
        
        <div class="flex flex-wrap gap-4 text-sm font-semibold justify-center md:justify-start">
          <a href="mailto:endji1507@gmail.com" class="px-7 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-full transition-all duration-300 shadow-lg shadow-blue-600/30 hover:shadow-blue-500/50 flex items-center gap-2">
            Hubungi Saya
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
          <a href="https://github.com/endjiansyah" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-white/5 border border-white/15 rounded-full hover:bg-white/10 text-white transition-all">GitHub</a>
          <a href="https://www.linkedin.com/in/endji-ansyah-30322a115/" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-white/5 border border-white/15 rounded-full hover:bg-white/10 text-white transition-all">LinkedIn</a>
        </div>
      </div>
      
      <!-- Photo Avatar Frame -->
      <div class="flex-shrink-0 order-first md:order-last">
        <div class="relative group">
          <div class="absolute -inset-3 bg-gradient-to-r from-blue-500 to-cyan-400 rounded-full blur-2xl opacity-30 group-hover:opacity-60 transition duration-700"></div>
          <div class="relative w-56 h-56 lg:w-80 lg:h-80 rounded-full overflow-hidden border-4 border-white/15 shadow-2xl transition-all duration-500 hover:border-blue-400/50 z-10">
            <img src="/assets/profile.webp" alt="Endjiansyah — Software Engineer, AI-Augmented Developer & Technical Mentor" width="382" height="382" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ======================== -->
  <!-- Section: The Journey     -->
  <!-- ======================== -->
  <section id="journey" class="py-24 sm:py-32 bg-[#F8FAFC] relative bg-grid-pattern">
    <div class="max-w-6xl mx-auto px-6 sm:px-12 md:px-20 relative reveal reveal-up">
      <!-- Section Header -->
      <div class="mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-50 px-3.5 py-1 rounded-full border border-blue-200/60 inline-block mb-3">
          Pengalaman & Perjalanan
        </span>
        <h3 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight font-display">The Journey</h3>
        <p class="text-gray-600 text-base sm:text-lg max-w-2xl mt-2 leading-relaxed font-normal">
          Perjalanan karir dari fondasi pemrograman web, manajemen produk &amp; rekayasa, hingga technical mentorship dengan pendekatan AI-augmented development.
        </p>
      </div>

      <!-- Stacked Layout: Pengalaman dulu, lalu Pendidikan -->
      <div class="space-y-10">

        <!-- Block 1: Pengalaman Kerja -->
        <div class="bg-white p-6 sm:p-10 rounded-3xl border border-gray-200/80 shadow-sm">
          <div class="flex flex-wrap items-center gap-4 mb-10">
            <div class="w-12 h-12 rounded-2xl bg-blue-600/10 flex items-center justify-center text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div class="flex-1 min-w-[200px]">
              <h4 class="text-2xl font-bold text-gray-900 tracking-tight">Pengalaman Kerja</h4>
              <p class="text-xs text-gray-400 font-medium uppercase tracking-wider">Rekam Jejak Profesional — 2018 hingga hari ini</p>
            </div>
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-xs font-semibold text-blue-700">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Aktif Bekerja di Alkademi
            </span>
          </div>

          <div class="relative border-l-2 border-blue-100 ml-4 md:ml-6 space-y-6 py-2">

            <!-- Node: Software Engineer & Technical Mentor (Saat Ini) -->
            <div class="relative pl-8 md:pl-10 group">
              <div class="absolute -left-[9px] top-5 w-4 h-4 bg-blue-600 border-4 border-white rounded-full shadow-md group-hover:scale-125 transition-transform"></div>
              <div class="rounded-2xl border border-blue-100/80 bg-blue-50/40 p-5 sm:p-6 hover:border-blue-300 transition-colors">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-2">
                  <span class="text-xs font-semibold text-blue-600 tracking-wider uppercase bg-blue-100/70 px-2.5 py-1 rounded-md">2026 — Present</span>
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 text-[11px] font-bold uppercase tracking-wider">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Saat Ini
                  </span>
                </div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                  <h5 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">Software Engineer &amp; Technical Mentor</h5>
                  <span class="inline-block px-3 py-0.5 bg-blue-50 text-blue-700 font-medium text-xs rounded-full border border-blue-100">Alkademi</span>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Memimpin bimbingan teknis dan penyusunan modul untuk program-program kolaborasi nasional, dengan pendekatan AI-augmented development.
                </p>
                <button type="button" class="detail-toggle mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-500 transition-colors" aria-expanded="false">
                  <span class="detail-toggle-label">Show Detail</span>
                  <svg class="w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                <div class="timeline-detail hidden mt-3 bg-white border border-blue-100 rounded-xl p-4">
                  <ul class="space-y-2 text-gray-600 leading-relaxed text-sm list-disc list-outside ml-4">
                    <li>Memimpin <em>technical mentorship</em> dan penyusunan modul untuk <strong>Microsoft Elevate Program</strong>.</li>
                    <li>Membimbing <strong>Games for Inclusion (Telkom x Agate x Alkademi)</strong> bagi siswa disabilitas di SLBN 1 Buleleng.</li>
                    <li>Mengintegrasikan <em>AI-Assisted Workflow</em> dalam pengawasan siswa magang dan <em>code review</em>.</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Node: PM/EM -->
            <div class="relative pl-8 md:pl-10 group">
              <div class="absolute -left-[9px] top-5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-blue-600 group-hover:scale-125 transition-all"></div>
              <div class="rounded-2xl border border-gray-100 bg-slate-50/70 p-5 sm:p-6 hover:border-blue-200 transition-colors">
                <div class="mb-2">
                  <span class="text-xs font-semibold text-gray-400 tracking-wider uppercase bg-gray-100 px-2.5 py-1 rounded-md">2024 — 2026</span>
                </div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                  <h5 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">Project Manager &amp; Engineering Manager</h5>
                  <span class="inline-block px-3 py-0.5 bg-gray-100 border border-gray-200 text-gray-600 font-medium text-xs rounded-full">Alkademi / inideku.id</span>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Mengawasi alur rekayasa perangkat lunak dan <em>roadmap</em> produk, menghubungkan kebutuhan bisnis dengan eksekusi arsitektur teknis secara efisien.
                </p>
                <button type="button" class="detail-toggle mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-500 transition-colors" aria-expanded="false">
                  <span class="detail-toggle-label">Show Detail</span>
                  <svg class="w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                <div class="timeline-detail hidden mt-3 bg-white border border-blue-100 rounded-xl p-4">
                  <ul class="space-y-2 text-gray-600 leading-relaxed text-sm list-disc list-outside ml-4">
                    <li>Mengawasi alur rekayasa perangkat lunak dan <em>roadmap</em> ekosistem LMS Alkademi.</li>
                    <li>Memimpin pengembangan fitur AI pada <strong>ASEAN Digital Academy Platform</strong>.</li>
                    <li>Mengelola proyek CSR <strong>AWS in Communities</strong> (Bansos &amp; Posyandu Karawang).</li>
                    <li>Memimpin <em>piloting project</em> Literasi AI berbasis <em>Minecraft Education Edition</em>.</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Node: Web Dev -->
            <div class="relative pl-8 md:pl-10 group">
              <div class="absolute -left-[9px] top-5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-blue-600 group-hover:scale-125 transition-all"></div>
              <div class="rounded-2xl border border-gray-100 bg-slate-50/70 p-5 sm:p-6 hover:border-blue-200 transition-colors">
                <div class="mb-2">
                  <span class="text-xs font-semibold text-gray-400 tracking-wider uppercase bg-gray-100 px-2.5 py-1 rounded-md">Jul 2023 — 2024</span>
                </div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                  <h5 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">Web Developer</h5>
                  <span class="inline-block px-3 py-0.5 bg-gray-100 border border-gray-200 text-gray-600 font-medium text-xs rounded-full">inideku.id &amp; Freelance</span>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Mengembangkan dan memelihara platform web berbasis TALL Stack dan integrasi ReactJS dengan fokus pada performa serta kemudahan pemeliharaan.
                </p>
              </div>
            </div>

            <!-- Node: Backend -->
            <div class="relative pl-8 md:pl-10 group">
              <div class="absolute -left-[9px] top-5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-blue-600 group-hover:scale-125 transition-all"></div>
              <div class="rounded-2xl border border-gray-100 bg-slate-50/70 p-5 sm:p-6 hover:border-blue-200 transition-colors">
                <div class="mb-2">
                  <span class="text-xs font-semibold text-gray-400 tracking-wider uppercase bg-gray-100 px-2.5 py-1 rounded-md">Mar 2023 — Jul 2023</span>
                </div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                  <h5 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">Backend Developer</h5>
                  <span class="inline-block px-3 py-0.5 bg-gray-100 border border-gray-200 text-gray-600 font-medium text-xs rounded-full">CODELITE</span>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Merancang layanan backend dengan bahasa Go (Golang) untuk membangun pemrosesan data yang stabil dan andal.
                </p>
              </div>
            </div>

            <!-- Node: Web Dev (Early) -->
            <div class="relative pl-8 md:pl-10 group">
              <div class="absolute -left-[9px] top-5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-gray-500 group-hover:scale-125 transition-all"></div>
              <div class="rounded-2xl border border-gray-100 bg-slate-50/70 p-5 sm:p-6 hover:border-gray-300 transition-colors">
                <div class="mb-2">
                  <span class="text-xs font-semibold text-gray-400 tracking-wider uppercase bg-gray-100 px-2.5 py-1 rounded-md">Dec 2020 — Oct 2022</span>
                </div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                  <h5 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">Freelance Web Developer</h5>
                  <span class="inline-block px-3 py-0.5 bg-gray-100 border border-gray-200 text-gray-600 font-medium text-xs rounded-full">Local Clients &amp; SMB</span>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Membangun solusi sistem kustom MVC berbasis PHP, CodeIgniter, dan Bootstrap untuk berbagai klien lokal.
                </p>
              </div>
            </div>

            <!-- Node: Internship -->
            <div class="relative pl-8 md:pl-10 group">
              <div class="absolute -left-[9px] top-5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-gray-500 group-hover:scale-125 transition-all"></div>
              <div class="rounded-2xl border border-gray-100 bg-slate-50/70 p-5 sm:p-6 hover:border-gray-300 transition-colors">
                <div class="mb-2">
                  <span class="text-xs font-semibold text-gray-400 tracking-wider uppercase bg-gray-100 px-2.5 py-1 rounded-md">Dec 2019 — Feb 2020</span>
                </div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                  <h5 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">Fullstack Intern</h5>
                  <span class="inline-block px-3 py-0.5 bg-gray-100 border border-gray-200 text-gray-600 font-medium text-xs rounded-full">Diskominfo Kab. Jepara</span>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Mengembangkan aplikasi pelaporan WBS (Whistleblowing System) sebagai pengalaman nyata pertama dalam sistem pemerintahan daerah.
                </p>
              </div>
            </div>

            <!-- Node: School Operator -->
            <div class="relative pl-8 md:pl-10 group">
              <div class="absolute -left-[9px] top-5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-gray-500 group-hover:scale-125 transition-all"></div>
              <div class="rounded-2xl border border-gray-100 bg-slate-50/70 p-5 sm:p-6 hover:border-gray-300 transition-colors">
                <div class="mb-2">
                  <span class="text-xs font-semibold text-gray-400 tracking-wider uppercase bg-gray-100 px-2.5 py-1 rounded-md">Dec 2018 — Jun 2019</span>
                </div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                  <h5 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">Operator Sekolah</h5>
                  <span class="inline-block px-3 py-0.5 bg-gray-100 border border-gray-200 text-gray-600 font-medium text-xs rounded-full">SMK MIS Jabal Nur</span>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Mengelola administrasi data teknis kependidikan dan sistem informasi di lingkungan sekolah menengah.
                </p>
              </div>
            </div>

          </div>
        </div>

        <!-- Block 2: Pendidikan & Pelatihan -->
        <div class="bg-white p-6 sm:p-10 rounded-3xl border border-gray-200/80 shadow-sm">
          <div class="flex flex-wrap items-center gap-4 mb-10">
            <div class="w-12 h-12 rounded-2xl bg-amber-600/10 flex items-center justify-center text-amber-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14v7"></path></svg>
            </div>
            <div class="flex-1 min-w-[200px]">
              <h4 class="text-2xl font-bold text-gray-900 tracking-tight">Pendidikan &amp; Pelatihan</h4>
              <p class="text-xs text-gray-400 font-medium uppercase tracking-wider">Fondasi Vokasi &amp; Akademik</p>
            </div>
          </div>

          <div class="relative border-l-2 border-amber-100 ml-4 md:ml-6 space-y-6 py-2">

            <!-- Node: Bootcamp -->
            <div class="relative pl-8 md:pl-10 group">
              <div class="absolute -left-[9px] top-5 w-4 h-4 bg-amber-500 border-4 border-white rounded-full shadow-md group-hover:scale-125 transition-transform"></div>
              <div class="rounded-2xl border border-amber-100/80 bg-amber-50/40 p-5 sm:p-6 hover:border-amber-300 transition-colors">
                <div class="mb-2">
                  <span class="text-xs font-semibold text-amber-600 tracking-wider uppercase bg-amber-100/70 px-2.5 py-1 rounded-md">Nov 2022 — Jan 2023</span>
                </div>
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                  <h5 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">Bootcamp Scholarship</h5>
                  <span class="inline-block px-3 py-0.5 bg-amber-50 text-amber-700 font-medium text-xs rounded-full border border-amber-200/60">Alkademi — UMPTN Farcapital</span>
                </div>
                <p class="text-gray-600 leading-relaxed text-sm">
                  Pelatihan intensif on-site di Bandung. Pendalaman praktik rekayasa perangkat lunak modern, arsitektur Laravel, dan pengerjaan proyek OCR kolaboratif.
                </p>
                <div class="timeline-detail mt-3 bg-white border border-amber-100 rounded-xl p-4">
                  <ul class="space-y-2 text-gray-600 leading-relaxed text-sm list-disc list-outside ml-4">
                    <li>Proyek OCR kolaboratif sebagai capstone program.</li>
                    <li>Arsitektur Laravel &amp; TALL Stack sebagai fondasi stack profesional.</li>
                    <li>Praktik rekayasa perangkat lunak modern: versioning, code review, dan kolaborasi tim.</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Node: College -->
            <div class="relative pl-8 md:pl-10 group">
              <div class="absolute -left-[9px] top-5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-amber-500 group-hover:scale-125 transition-all"></div>
              <div class="rounded-2xl border border-gray-100 bg-slate-50/70 p-5 sm:p-6 hover:border-amber-200 transition-colors">
                <div class="mb-2">
                  <span class="text-xs font-semibold text-gray-400 tracking-wider uppercase bg-gray-100 px-2.5 py-1 rounded-md">2018 — 2020</span>
