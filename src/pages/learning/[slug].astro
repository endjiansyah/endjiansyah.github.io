---
import LearningDetail from '../../components/pages/LearningDetail.astro';
import { getCollection } from 'astro:content';

// Static paths: gabungkan playlists + modules bahasa Indonesia.
// Modules di-fetch defensif: cek file via glob dulu agar tidak memicu warning saat kosong.
export async function getStaticPaths() {
  const playlists = (await getCollection('playlists')).filter((p) => p.data.lang === 'id');
  const moduleFiles = import.meta.glob('../../content/modules/*.md', { eager: true });
  const modules = Object.keys(moduleFiles).length > 0
    ? (await getCollection('modules')).filter((m) => m.data.lang === 'id')
    : [];

  const playlistPaths = playlists.map((p) => ({ params: { slug: p.slug }, props: { entry: p, kind: 'video' as const } }));
  const modulePaths = modules.map((m) => ({ params: { slug: m.slug }, props: { entry: m, kind: 'module' as const } }));

  return [...playlistPaths, ...modulePaths];
}

const { entry, kind } = Astro.props;
---

<LearningDetail entry={entry} kind={kind} />
