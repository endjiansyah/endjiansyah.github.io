---
interface Props {
  title: string;
  description: string;
  coverImage: string;
  tools: string[];
  slug: string;
  liveUrl?: string;
  featured?: boolean;
}

const { title, description, coverImage, tools, slug, liveUrl, featured = false } = Astro.props;
---

<a 
  href={`/works/${slug}`} 
  class={`reveal reveal-up group relative block rounded-3xl overflow-hidden bg-white border border-gray-200/80 shadow-sm hover:shadow-2xl hover:border-blue-500/30 transition-all duration-500 ease-out hover:-translate-y-1.5 ${featured ? 'md:col-span-2 grid grid-cols-1 md:grid-cols-12 items-center' : ''}`}
>
  <!-- Ambient Hover Glow -->
  <div class="absolute -inset-px bg-gradient-to-r from-blue-500/10 via-teal-500/10 to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

  <div class={`overflow-hidden relative bg-gray-100 ${featured ? 'md:col-span-7 h-64 md:h-full min-h-[300px]' : 'aspect-[16/10]'}`}>
    <img 
      src={coverImage} 
      alt={title} 
      class="w-full h-full object-cover project-card-img transition-transform duration-700 ease-out group-hover:scale-105" 
      loading="lazy" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900/40 via-transparent to-transparent opacity-60 group-hover:opacity-30 transition-opacity"></div>
  </div>

  <div class={`p-7 sm:p-8 flex flex-col justify-between relative z-10 ${featured ? 'md:col-span-5' : ''}`}>
    <div>
      <div class="flex items-center justify-between gap-4 mb-3">
        <h4 class="text-xl sm:text-2xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors tracking-tight leading-snug">
          {title}
        </h4>
        <div class="w-9 h-9 rounded-full bg-gray-100 group-hover:bg-blue-600 text-gray-500 group-hover:text-white flex items-center justify-center transition-all duration-300 flex-shrink-0 group-hover:rotate-45">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </div>
      </div>

      <p class="text-gray-600 text-sm leading-relaxed mb-6 font-normal">
        {description}
      </p>
    </div>

    <div class="flex gap-2 flex-wrap">
      {tools.map((tool) => (
        <span class="px-3 py-1 bg-gray-100/80 text-gray-600 font-medium rounded-full text-xs border border-gray-200/60 group-hover:border-blue-200 transition-colors">
          {tool}
        </span>
      ))}
    </div>
  </div>
</a>
