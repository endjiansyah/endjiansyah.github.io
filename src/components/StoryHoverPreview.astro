---
import { getCollection } from 'astro:content';
import { storyTypeStyle } from '../lib/storyTypes';

interface Props {
  lang?: string;
}

const { lang = 'id' } = Astro.props;

const allStories = await getCollection('stories');

// Build lookup map for all stories (both id & en)
const storyLookup: Record<string, {
  title: string;
  description: string;
  coverImage: string;
  date: string;
  badge: string;
  typeLabel: string;
}> = {};

for (const s of allStories) {
  const isEn = s.slug.endsWith('-en') || s.data.lang === 'en';
  const cleanSlug = s.slug.replace(/-en$/, '');
  const style = storyTypeStyle(s.data.type);
  const sLocale = isEn ? 'en-US' : 'id-ID';
  const dateStr = s.data.dateLabel || s.data.date.toLocaleDateString(sLocale, { year: 'numeric', month: 'short' });
  
  const keyWithLang = `${isEn ? 'en' : 'id'}:${cleanSlug}`;
  const data = {
    title: s.data.title,
    description: s.data.description,
    coverImage: s.data.coverImage,
    date: dateStr,
    badge: style.badge,
    typeLabel: style.label,
  };

  storyLookup[keyWithLang] = data;
  if ((lang === 'en' && isEn) || (lang !== 'en' && !isEn)) {
    storyLookup[cleanSlug] = data;
  }
}
---

<!-- Floating Story Preview Card Container -->
<a
  id="story-hover-card"
  href="#"
  class="fixed pointer-events-none opacity-0 scale-95 transition-all duration-200 z-50 w-72 sm:w-80 bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl border border-gray-200/90 overflow-hidden group block"
  style="top: -9999px; left: -9999px;"
  aria-hidden="true"
>
  <div class="relative h-28 sm:h-32 w-full overflow-hidden bg-gray-900">
    <img id="shc-img" src="" alt="" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-950/80 via-gray-950/20 to-transparent"></div>
    <span id="shc-badge" class="absolute top-2.5 left-2.5 px-2.5 py-0.5 text-[10px] font-bold rounded-full border shadow-sm"></span>
    <span id="shc-date" class="absolute bottom-2 left-3 text-[10px] font-semibold text-gray-300 uppercase tracking-wider"></span>
  </div>
  <div class="p-3.5 bg-white">
    <h4 id="shc-title" class="text-xs sm:text-sm font-bold text-gray-900 group-hover:text-blue-600 transition-colors leading-snug line-clamp-2 mb-1.5"></h4>
    <p id="shc-desc" class="text-[11px] text-gray-500 line-clamp-2 leading-relaxed mb-2.5"></p>
    <div class="flex items-center text-[10px] font-semibold text-blue-600 group-hover:translate-x-0.5 transition-transform gap-1">
      <span>{lang === 'en' ? 'Read full story' : 'Baca cerita selengkapnya'}</span>
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </div>
  </div>
</a>

<script is:inline define:vars={{ storyLookup, pageLang: lang }}>
  (function() {
    if (window.matchMedia && !window.matchMedia('(hover: hover)').matches) {
      return;
    }

    function initStoryHoverPreview() {
      const card = document.getElementById('story-hover-card');
      const img = document.getElementById('shc-img');
      const badge = document.getElementById('shc-badge');
      const date = document.getElementById('shc-date');
      const title = document.getElementById('shc-title');
      const desc = document.getElementById('shc-desc');
      
      if (!card || !img || !badge || !date || !title || !desc) return;

      let hideTimeout = null;

      function getStoryData(href) {
        if (!href) return null;
        const match = href.match(/(?:\/(en))?\/stories\/([a-zA-Z0-9_-]+)/);
        if (!match) return null;
        const isEn = match[1] === 'en' || pageLang === 'en';
        const slug = match[2];
        const langKey = `${isEn ? 'en' : 'id'}:${slug}`;
        return storyLookup[langKey] || storyLookup[slug] || null;
      }

      function showCard(linkEl, storyData) {
        clearTimeout(hideTimeout);
        
        card.href = linkEl.getAttribute('href') || '#';
        img.src = storyData.coverImage;
        img.alt = storyData.title;
        badge.textContent = storyData.typeLabel;
        badge.className = `absolute top-2.5 left-2.5 px-2.5 py-0.5 text-[10px] font-bold rounded-full border shadow-sm ${storyData.badge}`;
        date.textContent = storyData.date;
        title.textContent = storyData.title;
        desc.textContent = storyData.description;

        const rect = linkEl.getBoundingClientRect();
        const cardWidth = Math.min(320, window.innerWidth - 24);
        const cardHeight = card.offsetHeight || 230;

        let left = rect.left + (rect.width / 2) - (cardWidth / 2);
        if (left < 12) left = 12;
        if (left + cardWidth > window.innerWidth - 12) {
          left = window.innerWidth - cardWidth - 12;
        }

        let top = rect.top - cardHeight - 10;
        if (top < 12) {
          top = rect.bottom + 10;
        }

        card.style.left = `${left}px`;
        card.style.top = `${top}px`;
        card.classList.remove('opacity-0', 'scale-95', 'pointer-events-none');
        card.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
      }

      function hideCard() {
        hideTimeout = setTimeout(() => {
          card.classList.add('opacity-0', 'scale-95', 'pointer-events-none');
          card.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
        }, 150);
      }

      // Allow keeping open while hovering over the preview card itself
      card.addEventListener('mouseenter', () => clearTimeout(hideTimeout));
      card.addEventListener('mouseleave', hideCard);

      const links = document.querySelectorAll('.prose a[href*="/stories/"], a[data-story-preview]');
      links.forEach((link) => {
        const href = link.getAttribute('href');
        if (!href) return;
        if (href.replace(/\/$/, '') === window.location.pathname.replace(/\/$/, '')) return;

        const storyData = getStoryData(href);
        if (!storyData) return;

        link.addEventListener('mouseenter', () => showCard(link, storyData));
        link.addEventListener('mouseleave', hideCard);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStoryHoverPreview);
    } else {
      initStoryHoverPreview();
    }
  })();
</script>
