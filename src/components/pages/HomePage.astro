---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../Navbar.astro';
import Footer from '../Footer.astro';
import WorkCard from '../WorkCard.astro';
import StoryCard from '../StoryCard.astro';
import EducationCard from '../EducationCard.astro';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import { getCollection } from 'astro:content';
import { langFromPath, t, type Lang } from '../../lib/i18n';

interface Props {
  /** Bahasa dasar halaman. Slug pasangan EN dijaga sama. */
  langFallback?: Lang;
}

const { langFallback } = Astro.props;
const lang: Lang = langFallback ?? langFromPath(Astro.url.pathname);

// Konten dipisah per bahasa; EN tersedia sebagai file pendamping *.en.md.
const worksAll = await getCollection('works');
const storiesAll = await getCollection('stories');
const eduAll = await getCollection('playlists');
const moduleFiles = import.meta.glob('../../content/modules/*.md', { eager: true });
const modulesAll = Object.keys(moduleFiles).length > 0 ? await getCollection('modules') : [];

const byLang = <T extends { data: { lang?: string } }>(a: T[], lang: Lang) =>
  a.filter((e) => e.data.lang === lang);

const allWorks = byLang(worksAll, lang).sort((a, b) => a.data.order - b.data.order);
const allStories = byLang(storiesAll, lang).sort((b, a) => b.data.date.getTime() - a.data.date.getTime());

// Education: playlists + modules
const eduPlaylists = byLang(eduAll, lang);
const eduModules = byLang(modulesAll, lang);
const allEducation = [
  ...eduPlaylists.map((p) => ({ ...p, kind: 'video' as const })),
  ...eduModules.map((m) => ({ ...m, kind: 'module' as const })),
].sort((a, b) => a.data.order - b.data.order);
const INITIAL_EDU_COUNT = 6;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://endjiansyah.github.io/#person",
  "name": "Endjiansyah",
  "alternateName": "Endji Ansyah",
  "url": "https://endjiansyah.github.io",
  // ImageObject lengkap: Google Images butuh dimensi + caption, bukan sekadar string URL.
  "image": {
    "@type": "ImageObject",
    "@id": "https://endjiansyah.github.io/#portrait",
    "url": "https://endjiansyah.github.io/assets/profile.webp",
    "contentUrl": "https://endjiansyah.github.io/assets/profile.webp",
    "width": 382,
    "height": 382,
    "caption": "Foto Endjiansyah, Software Engineer, AI-Augmented Developer & Technical Mentor",
    "name": "Endjiansyah",
    "encodingFormat": "image/webp",
    "representativeOfPage": true,
    "author": { "@id": "https://endjiansyah.github.io/#person" }
  },
  "description": "Software Engineer, AI-Augmented Developer & Technical Mentor",
  "jobTitle": "Software Engineer / Technical Mentor",
  "knowsLanguage": ["id", "en"],
  "worksFor": {
    "@type": "Organization",
    "name": "Alkademi"
  },
  "sameAs": [
    "https://github.com/endjiansyah",
    "https://www.linkedin.com/in/endjiansyah/"
  ]
};

// ========================
// Data Timeline Pengalaman Kerja & Pendidikan (biar ringkas + tipedua bahasa)
// ========================
interface TItem {
  period: string;
  periodEn?: string;
  role: { id: string; en: string };
  org: string;
  orgNote?: { id: string; en: string };
  summary: { id: string; en: string };
  detail: { id: string[]; en: string[] };
  current?: boolean;
}
const experience: TItem[] = [
  {
    period: '2026 — Present',
    role: { id: 'Software Engineer & Technical Mentor', en: 'Software Engineer & Technical Mentor' },
    org: 'Alkademi',
    orgNote: undefined,
    summary: {
      id: 'Memimpin bimbingan teknis dan penyusunan modul untuk program-program kolaborasi nasional, dengan pendekatan AI-augmented development.',
      en: 'Leading technical mentorship and module authoring for national collaboration programs, with an AI-augmented development approach.',
    },
    detail: {
      id: [
        'Memimpin technical mentorship dan penyusunan modul untuk Microsoft Elevate Program.',
        'Membimbing Games for Inclusion (Telkom x Agate x Alkademi) bagi siswa disabilitas di SLBN 1 Buleleng.',
        'Mengintegrasikan AI-Assisted Workflow dalam pengawasan siswa magang dan code review.',
      ],
      en: [
        'Leading technical mentorship and module authoring for the Microsoft Elevate Program.',
        'Mentoring Games for Inclusion (Telkom x Agate x Alkademi) for students with disabilities at SLBN 1 Buleleng.',
        'Integrating an AI-Assisted Workflow to supervise interns and conduct code reviews.',
      ],
    },
    current: true,
  },
  {
    period: '2024 — 2026',
    role: { id: 'Project Manager & Engineering Manager', en: 'Project Manager & Engineering Manager' },
    org: 'Alkademi / inideku.id',
    summary: {
      id: 'Mengawasi alur rekayasa perangkat lunak dan roadmap produk, menghubungkan kebutuhan bisnis dengan eksekusi arsitektur teknis secara efisien.',
      en: 'Overseeing the software engineering flow and the product roadmap, connecting business needs to efficient technical architecture execution.',
    },
    detail: {
      id: [
        'Mengawasi alur rekayasa perangkat lunak dan roadmap ekosistem LMS Alkademi.',
        'Memimpin pengembangan fitur AI pada ASEAN Digital Academy Platform.',
        'Mengelola proyek CSR AWS in Communities (Bansos & Posyandu Karawang).',
        'Memimpin piloting project Literasi AI berbasis Minecraft Education Edition.',
      ],
      en: [
        'Overseeing the software engineering flow and the roadmap of the Alkademi LMS ecosystem.',
        'Leading the development of AI features on the ASEAN Digital Academy Platform.',
        'Managing the AWS in Communities CSR project (Bansos & Posyandu Karawang).',
        'Leading the AI literacy pilot project based on Minecraft Education Edition.',
      ],
    },
  },
  {
    period: 'Jul 2023 — 2024',
    role: { id: 'Web Developer', en: 'Web Developer' },
    org: 'inideku.id & Freelance',
    summary: {
      id: 'Mengembangkan dan memelihara platform web berbasis TALL Stack dan integrasi ReactJS dengan fokus pada performa serta kemudahan pemeliharaan.',
      en: 'Developing and maintaining TALL Stack web platforms and ReactJS integrations with a focus on performance and maintainability.',
    },
    detail: { id: [], en: [] },
  },
  {
    period: 'Mar 2023 — Jul 2023',
    role: { id: 'Backend Developer', en: 'Backend Developer' },
    org: 'CODELITE',
    summary: {
      id: 'Merancang layanan backend dengan bahasa Go (Golang) untuk membangun pemrosesan data yang stabil dan andal.',
      en: 'Designing backend services in Go (Golang) to build stable and reliable data processing.',
    },
    detail: { id: [], en: [] },
  },
  {
    period: 'Dec 2020 — Oct 2022',
    role: { id: 'Freelance Web Developer', en: 'Freelance Web Developer' },
    org: 'Local Clients & SMB',
    summary: {
      id: 'Membangun solusi sistem kustom MVC berbasis PHP, CodeIgniter, dan Bootstrap untuk berbagai klien lokal.',
      en: 'Building custom PHP MVC systems with CodeIgniter and Bootstrap for various local clients.',
    },
    detail: { id: [], en: [] },
  },
  {
    period: 'Dec 2019 — Feb 2020',
    role: { id: 'Fullstack Intern', en: 'Fullstack Intern' },
    org: 'Diskominfo Kab. Jepara',
    summary: {
      id: 'Mengembangkan aplikasi pelaporan WBS (Whistleblowing System) sebagai pengalaman nyata pertama dalam sistem pemerintahan daerah.',
      en: 'Developing a Whistleblowing System (WBS) reporting app — my first real experience in a regional government system.',
    },
    detail: { id: [], en: [] },
  },
  {
    period: 'Dec 2018 — Jun 2019',
    role: { id: 'Operator Sekolah', en: 'School Operator' },
    org: 'SMK MIS Jabal Nur',
    summary: {
      id: 'Mengelola administrasi data teknis kependidikan dan sistem informasi di lingkungan sekolah menengah.',
      en: 'Managing education data administration and information systems in a secondary school.',
    },
    detail: { id: [], en: [] },
  },
];
const education: TItem[] = [
  {
    period: 'Nov 2022 — Jan 2023',
    role: { id: 'Bootcamp Scholarship', en: 'Bootcamp Scholarship' },
    org: 'Alkademi — UMPTN Farcapital',
    summary: {
      id: 'Pelatihan intensif on-site di Bandung. Pendalaman praktik rekayasa perangkat lunak modern, arsitektur Laravel, dan pengerjaan proyek OCR kolaboratif.',
      en: 'Intensive on-site training in Bandung. Deepening modern software engineering practice, Laravel architecture, and a collaborative OCR project.',
    },
    detail: {
      id: [
        'Proyek OCR kolaboratif sebagai capstone program.',
        'Arsitektur Laravel & TALL Stack sebagai fondasi stack profesional.',
        'Praktik rekayasa perangkat lunak modern: versioning, code review, dan kolaborasi tim.',
      ],
      en: [
        'A collaborative OCR project as the program capstone.',
        'Laravel architecture & the TALL Stack as a professional stack foundation.',
        'Modern software engineering practice: versioning, code review, and team collaboration.',
      ],
    },
  },
  {
    period: '2018 — 2020',
    role: { id: 'Pendidikan D2 Manajemen Informatika', en: 'D2 Diploma in Informatics Management' },
    org: 'Politeknik Negeri Malang',
    summary: {
      id: 'Mempelajari logika dasar pemrograman, perancangan basis data relasional, algoritma, serta metodologi pengembangan perangkat lunak.',
      en: 'Studying core programming logic, relational database design, algorithms, and software development methodology.',
    },
    detail: { id: [], en: [] },
  },
  {
    period: '2015 — 2018',
    role: { id: 'Teknik Komputer & Jaringan', en: 'Computer & Network Engineering' },
    org: 'SMK Negeri 3 Jepara',
    summary: {
      id: 'Pendidikan vokasi dasar infrastruktur TI, arsitektur hardware, topologi jaringan komputer, dan sistem operasi Linux.',
      en: 'Vocational basics of IT infrastructure, hardware architecture, computer network topology, and Linux operating systems.',
    },
    detail: { id: [], en: [] },
  },
];
---

<BaseLayout
  lang={lang}
  title={`Endjiansyah — Software Engineer, AI-Augmented Developer & Technical Mentor`}
  ogImage="/assets/profile.webp"
  jsonSchema={personSchema}
>
  <Navbar slot="nav" />
  <LanguageSwitcher />

  <!-- ======================== -->
  <!-- Hero Section             -->
  <!-- ======================== -->
  <section id="hero" class="relative bg-[#0B132B] text-white min-h-[92vh] flex items-center px-6 sm:px-12 md:px-20 overflow-hidden bg-grid-pattern-dark">
    <!-- Ambient glowing light spots -->
    <div class="absolute top-1/4 right-10 w-[350px] h-[350px] sm:w-[650px] sm:h-[650px] bg-blue-600/15 rounded-full blur-[100px] sm:blur-[140px] pointer-events-none"></div>
    <div class="absolute bottom-10 left-10 w-[250px] h-[250px] sm:w-[500px] sm:h-[500px] bg-cyan-500/10 rounded-full blur-[80px] sm:blur-[120px] pointer-events-none"></div>

    <div class="max-w-6xl mx-auto relative z-10 flex flex-col md:flex-row justify-between items-center gap-12 md:gap-16 py-24 sm:py-32 w-full reveal reveal-up">
      <div class="flex-1 text-center md:text-left">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-semibold tracking-wide text-blue-300 mb-8 backdrop-blur-md">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Software Engineer &bull; AI-Augmented Developer &bull; Technical Mentor
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight mb-4 leading-[1.08] font-display">
          Endjiansyah<span class="text-blue-500">.</span>
        </h1>
        <h2 class="text-lg md:text-xl text-blue-200/80 font-medium tracking-wide mb-6">
          Software Engineer &bull; AI-Augmented Developer &bull; Technical Mentor
        </h2>
        <p class="text-base md:text-lg leading-relaxed text-slate-300/90 max-w-xl mx-auto md:mx-0 font-normal mb-10">
          {t(lang, 'hero.bio')}
        </p>

        <div class="flex flex-wrap gap-4 text-sm font-semibold justify-center md:justify-start">
          <a href="mailto:endji1507@gmail.com" class="px-7 py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-full transition-all duration-300 shadow-lg shadow-blue-600/30 hover:shadow-blue-500/50 flex items-center gap-2">
            {t(lang, 'hero.contact')}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </a>
          <a href="https://github.com/endjiansyah" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-white/5 border border-white/15 rounded-full hover:bg-white/10 text-white transition-all">GitHub</a>
          <a href="https://www.linkedin.com/in/endjiansyah/" target="_blank" rel="noopener noreferrer" class="px-6 py-3 bg-white/5 border border-white/15 rounded-full hover:bg-white/10 text-white transition-all">LinkedIn</a>
        </div>
      </div>

      <!-- Photo Avatar Frame -->
      <div class="flex-shrink-0 order-first md:order-last">
        <div class="relative group">
          <div class="absolute -inset-3 bg-gradient-to-r from-blue-500 to-cyan-400 rounded-full blur-2xl opacity-30 group-hover:opacity-60 transition duration-700"></div>
          <div class="relative w-56 h-56 lg:w-80 lg:h-80 rounded-full overflow-hidden border-4 border-white/15 shadow-2xl transition-all duration-500 hover:border-blue-400/50 z-10">
            <img src="/assets/profile.webp" alt="Endjiansyah — Software Engineer, AI-Augmented Developer & Technical Mentor" width="382" height="382" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ======================== -->
  <!-- Section: The Journey     -->
  <!-- ======================== -->
  <section id="journey" class="py-24 sm:py-32 bg-[#F8FAFC] relative bg-grid-pattern">
    <div class="max-w-6xl mx-auto px-6 sm:px-12 md:px-20 relative reveal reveal-up">
      <!-- Section Header -->
      <div class="mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-50 px-3.5 py-1 rounded-full border border-blue-200/60 inline-block mb-3">
          {t(lang, 'journey.pill')}
        </span>
        <h3 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight font-display">{t(lang, 'journey.title')}</h3>
        <p class="text-gray-600 text-base sm:text-lg max-w-2xl mt-2 leading-relaxed font-normal">
          {t(lang, 'journey.desc')}
        </p>
      </div>

      <!-- Stacked Layout: Pengalaman dulu, lalu Pendidikan -->
      <div class="space-y-10">

        <!-- Block 1: Pengalaman Kerja -->
        <div class="bg-white p-6 sm:p-10 rounded-3xl border border-gray-200/80 shadow-sm">
          <div class="flex flex-wrap items-center gap-4 mb-10">
            <div class="w-12 h-12 rounded-2xl bg-blue-600/10 flex items-center justify-center text-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div class="flex-1 min-w-[200px]">
              <h4 class="text-2xl font-bold text-gray-900 tracking-tight">{t(lang, 'journey.expTitle')}</h4>
              <p class="text-xs text-gray-400 font-medium uppercase tracking-wider">{t(lang, 'journey.expSub')}</p>
            </div>
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-xs font-semibold text-blue-700">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              {t(lang, 'journey.activeBadge')}
            </span>
          </div>

          <div class="relative border-l-2 border-blue-100 ml-4 md:ml-6 space-y-6 py-2">
            {experience.map((item: TItem) => (
              <div class="relative pl-8 md:pl-10 group">
                {item.current ? (
                  <div class="absolute -left-[9px] top-5 w-4 h-4 bg-blue-600 border-4 border-white rounded-full shadow-md group-hover:scale-125 transition-transform"></div>
                ) : (
                  <div class="absolute -left-[9px] top-5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-blue-600 group-hover:scale-125 transition-all"></div>
                )}
                <div class:list={[
                  'rounded-2xl border p-5 sm:p-6 transition-colors',
                  item.current ? 'border-blue-100/80 bg-blue-50/40 hover:border-blue-300' : 'border-gray-100 bg-slate-50/70 hover:border-blue-200',
                ]}>
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-2">
                    <span class:list={[
                      'text-xs font-semibold tracking-wider uppercase px-2.5 py-1 rounded-md',
                      item.current ? 'text-blue-600 bg-blue-100/70' : 'text-gray-400 bg-gray-100',
                    ]}>{item.period}</span>
                    {item.current && (
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 text-[11px] font-bold uppercase tracking-wider">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>{t(lang, 'journey.nowBadge')}
                      </span>
                    )}
                  </div>
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                    <h5 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">{item.role[lang]}</h5>
                    <span class:list={[
                      'inline-block px-3 py-0.5 font-medium text-xs rounded-full',
                      item.current ? 'bg-blue-50 text-blue-700 border border-blue-100' : 'bg-gray-100 border border-gray-200 text-gray-600',
                    ]}>{item.org}</span>
                  </div>
                  <p class="text-gray-600 leading-relaxed text-sm">{item.summary[lang]}</p>
                  {item.detail[lang].length > 0 && (
                    <>
                      <button type="button" class="detail-toggle mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-500 transition-colors" aria-expanded="false"
                        data-show-label={t(lang, 'journey.showDetail')}
                        data-hide-label={t(lang, 'journey.hideDetail')}>
                        <span class="detail-toggle-label">{t(lang, 'journey.showDetail')}</span>
                        <svg class="w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                      </button>
                      <div class="timeline-detail hidden mt-3 bg-white border border-blue-100 rounded-xl p-4">
                        <ul class="space-y-2 text-gray-600 leading-relaxed text-sm list-disc list-outside ml-4">
                          {item.detail[lang].map((li) => (
                            <li>{li}</li>
                          ))}
                        </ul>
                      </div>
                    </>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Block 2: Pendidikan & Pelatihan -->
        <div class="bg-white p-6 sm:p-10 rounded-3xl border border-gray-200/80 shadow-sm">
          <div class="flex flex-wrap items-center gap-4 mb-10">
            <div class="w-12 h-12 rounded-2xl bg-amber-600/10 flex items-center justify-center text-amber-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14v7"></path></svg>
            </div>
            <div class="flex-1 min-w-[200px]">
              <h4 class="text-2xl font-bold text-gray-900 tracking-tight">{t(lang, 'journey.eduTitle')}</h4>
              <p class="text-xs text-gray-400 font-medium uppercase tracking-wider">{t(lang, 'journey.eduSub')}</p>
            </div>
          </div>

          <div class="relative border-l-2 border-amber-100 ml-4 md:ml-6 space-y-6 py-2">
            {education.map((item: TItem) => (
              <div class="relative pl-8 md:pl-10 group">
                <div class="absolute -left-[9px] top-5 w-4 h-4 bg-white border-4 border-gray-300 rounded-full group-hover:border-amber-500 group-hover:scale-125 transition-all"></div>
                <div class="rounded-2xl border border-gray-100 bg-slate-50/70 p-5 sm:p-6 hover:border-amber-200 transition-colors">
                  <div class="mb-2">
                    <span class="text-xs font-semibold text-gray-400 tracking-wider uppercase bg-gray-100 px-2.5 py-1 rounded-md">{item.period}</span>
                  </div>
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                    <h5 class="text-lg sm:text-xl font-bold text-gray-900 tracking-tight">{item.role[lang]}</h5>
                    <span class="inline-block px-3 py-0.5 bg-gray-100 border border-gray-200 text-gray-600 font-medium text-xs rounded-full">{item.org}</span>
                  </div>
                  <p class="text-gray-600 leading-relaxed text-sm">{item.summary[lang]}</p>
                  {item.org === 'Politeknik Negeri Malang' && (
                    <a href="https://pddikti.kemdiktisaintek.go.id/detail-mahasiswa/h8PPNWiAZ06XP9GjTv55LSnGyqGcJ3xknlA2kTTz6IwIkPc3IpPnf7273ZqUwuu7oyfiDQ==" target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-amber-600 hover:text-amber-500 transition-colors">
                      {t(lang, 'journey.pddikti')}
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                  )}
                  {item.detail[lang].length > 0 && (
                    <div class="timeline-detail mt-3 bg-white border border-amber-100 rounded-xl p-4">
                      <ul class="space-y-2 text-gray-600 leading-relaxed text-sm list-disc list-outside ml-4">
                        {item.detail[lang].map((li) => (
                          <li>{li}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ======================== -->
  <!-- Section: Selected Works  -->
  <!-- ======================== -->
  <section id="works" class="py-24 sm:py-32 bg-white relative">
    <div class="max-w-6xl mx-auto px-6 sm:px-12 md:px-20 reveal reveal-up">
      <!-- Section Header -->
      <div class="mb-14">
        <span class="text-xs font-bold uppercase tracking-widest text-blue-600 bg-blue-50 px-3.5 py-1 rounded-full border border-blue-200/60 inline-block mb-3">
          {t(lang, 'works.pill')}
        </span>
        <h3 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight font-display">{t(lang, 'works.title')}</h3>
