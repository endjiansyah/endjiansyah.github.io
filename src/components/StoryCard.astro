---
interface Props {
  title: string;
  description: string;
  coverImage: string;
  type: 'mentoring' | 'event' | 'bootcamp' | 'other';
  tags?: string[];
  slug: string;
  date: Date;
  endDate?: Date;
  dateLabel?: string;
}

const { title, description, coverImage, type, tags, slug, date, endDate, dateLabel } = Astro.props;

const typeStyles: Record<string, { bg: string; text: string; label: string }> = {
  mentoring: { bg: 'bg-indigo-50/90 text-indigo-700 border-indigo-200/60', text: 'text-indigo-700', label: 'Mentoring' },
  event: { bg: 'bg-amber-50/90 text-amber-800 border-amber-200/60', text: 'text-amber-800', label: 'Inisiatif / Event' },
  bootcamp: { bg: 'bg-orange-50/90 text-orange-800 border-orange-200/60', text: 'text-orange-800', label: 'Karir & Vokasi' },
  other: { bg: 'bg-teal-50/90 text-teal-800 border-teal-200/60', text: 'text-teal-800', label: 'Field Note' },
};

const style = typeStyles[type] || typeStyles.other;
---

<a 
  href={`/stories/${slug}`} 
  class="reveal reveal-up group relative flex flex-col justify-between block bg-white rounded-3xl overflow-hidden border border-gray-200/80 shadow-sm hover:shadow-xl hover:border-blue-400/30 transition-all duration-500 ease-out hover:-translate-y-1.5"
>
  <div class="h-52 w-full overflow-hidden relative bg-gray-900">
    <img 
      src={coverImage} 
      alt={title} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out opacity-90 group-hover:opacity-100" 
      loading="lazy" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-950/80 via-gray-950/20 to-transparent"></div>
    
    <!-- Type badge -->
    <div class="absolute top-4 left-4">
      <span class={`px-3.5 py-1 text-xs font-semibold rounded-full border backdrop-blur-md shadow-sm ${style.bg}`}>
        {style.label}
      </span>
    </div>

    <!-- Title on Image Overlay -->
    <div class="absolute bottom-4 left-5 right-5">
      <h4 class="text-white text-lg font-bold leading-tight group-hover:text-blue-200 transition-colors line-clamp-2">
        {title}
      </h4>
    </div>
  </div>

  <div class="p-6 sm:p-7 flex flex-col justify-between flex-1">
    <div>
      <!-- Date display -->
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-3 tracking-wider uppercase">
        <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        {dateLabel || date.toLocaleDateString('id-ID', { year: 'numeric', month: 'long' })}
      </div>

      <p class="text-gray-600 text-sm leading-relaxed mb-6 line-clamp-3 font-normal">
        {description}
      </p>
    </div>

    {tags && tags.length > 0 && (
      <div class="flex gap-2 flex-wrap pt-4 border-t border-gray-100">
        {tags.map((tag) => (
          <span class="px-3 py-0.5 bg-gray-100/70 text-gray-500 rounded-full text-xs font-medium border border-gray-200/50">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
