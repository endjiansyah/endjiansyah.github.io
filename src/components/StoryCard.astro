---
import { storyTypeStyle, type StoryType } from '../lib/storyTypes';
import type { Lang } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  coverImage: string;
  type: StoryType;
  tags?: string[];
  slug: string;
  date: Date;
  dateLabel?: string;
  lang?: Lang;
  /** Nama penulis, dipakai untuk memperkaya alt text (Image SEO). */
  authorName?: string;
}

const { title, description, coverImage, type, tags, slug, date, dateLabel, lang: langProp, authorName = 'Endjiansyah' } = Astro.props;
const lang: Lang = langProp ?? (Astro.url.pathname.startsWith('/en') ? 'en' : 'id');
const base = lang === 'en' ? '/en' : '';
const localeDate = date.toLocaleDateString(lang === 'en' ? 'en-US' : 'id-ID', { year: 'numeric', month: 'long' });

const style = storyTypeStyle(type);

const isCore = slug === 'umptn-farcapital' || slug === 'project-manager-alkademi';
// Core cards feature an emas tipis / kuning tipis dengan gradasi putih background; border and typography remain 100% standard
const cardBg = isCore
  ? 'bg-gradient-to-b from-amber-100/45 via-white to-amber-50/30'
  : 'bg-white';
---

<a 
  href={`${base}/stories/${slug}`} 
  class={`reveal reveal-up group relative flex flex-col justify-between block h-full ${cardBg} rounded-3xl overflow-hidden border border-gray-200/80 shadow-sm hover:shadow-2xl hover:border-blue-500/30 transition-all duration-500 ease-out hover:-translate-y-1.5`}
>
  <!-- Ambient Hover Glow -->
  <div class="absolute -inset-px bg-gradient-to-r from-blue-500/10 via-teal-500/10 to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

  <!-- Deepened subtle gold gradient on hover for core cards -->
  {isCore && (
    <div class="absolute inset-0 bg-gradient-to-b from-amber-200/40 via-amber-100/25 to-amber-100/35 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
  )}

  <div class="h-52 w-full overflow-hidden relative bg-gray-900">
    <img 
      src={coverImage} 
      alt={`${title} — dokumentasi ${authorName}`} 
      width="1200"
      height="800"
      class="w-full h-full object-cover project-card-img transition-transform duration-700 ease-out opacity-90 group-hover:opacity-100 group-hover:scale-105" 
      loading="lazy" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-950/80 via-gray-950/20 to-transparent opacity-70 group-hover:opacity-50 transition-opacity"></div>
    
    <!-- Type badge -->
    <div class="absolute top-4 left-4">
      <span class={`px-3.5 py-1 text-xs font-semibold rounded-full border backdrop-blur-md shadow-sm ${style.badge}`}>
        {style.label}
      </span>
    </div>

    <!-- Title on Image Overlay -->
    <div class="absolute bottom-4 left-5 right-5">
      <h4 class="text-white text-lg font-bold leading-tight group-hover:text-blue-200 transition-colors line-clamp-2">
        {title}
      </h4>
    </div>
  </div>

  <div class="p-6 sm:p-7 flex flex-col justify-between flex-1 relative z-10">
    <div>
      <!-- Date display -->
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-3 tracking-wider uppercase">
        <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        {dateLabel || localeDate}
      </div>

      <p class="text-gray-600 text-sm leading-relaxed mb-6 line-clamp-3 font-normal">
        {description}
      </p>
    </div>

    {tags && tags.length > 0 && (
      <div class="flex gap-2 flex-wrap pt-4 border-t border-gray-100 items-center">
        {tags.slice(0, 3).map((tag) => (
          <span class="px-3 py-0.5 bg-gray-100/70 text-gray-500 rounded-full text-xs font-medium border border-gray-200/50 group-hover:border-blue-200 transition-colors">
            #{tag}
          </span>
        ))}
        {tags.length > 3 && (
          <span class="px-2 py-0.5 text-gray-400 text-xs font-medium" title={tags.slice(3).map((t) => `#${t}`).join(', ')}>
            +{tags.length - 3}
          </span>
        )}
      </div>
    )}
  </div>
</a>
