---
interface Props {
  title: string;
  description: string;
  coverImage: string;
  kind: 'video' | 'module';
  slug: string;
  tags?: string[];
  videoCount?: number;
  readTime?: string;
  date: Date;
}

const { title, description, coverImage, kind, slug, tags, videoCount, readTime, date } = Astro.props;

const kindStyles = {
  video: { bg: 'bg-red-50/90 text-red-700 border-red-200/60', label: 'Video Course', icon: 'play' },
  module: { bg: 'bg-emerald-50/90 text-emerald-800 border-emerald-200/60', label: 'Modul Bacaan', icon: 'doc' },
};
const style = kindStyles[kind];

const formattedDate = date.toLocaleDateString('id-ID', { year: 'numeric', month: 'long' });
---

<a 
  href={`/learning/${slug}`} 
  class="reveal reveal-up group relative flex flex-col justify-between block bg-white rounded-3xl overflow-hidden border border-gray-200/80 shadow-sm hover:shadow-xl hover:border-blue-400/30 transition-all duration-500 ease-out hover:-translate-y-1.5"
>
  <div class="h-52 w-full overflow-hidden relative bg-gray-900">
    <img 
      src={coverImage} 
      alt={title} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out opacity-90 group-hover:opacity-100" 
      loading="lazy" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-gray-950/80 via-gray-950/20 to-transparent"></div>
    
    <!-- Kind badge -->
    <div class="absolute top-4 left-4 flex items-center gap-1.5">
      <span class={`px-3.5 py-1 text-xs font-semibold rounded-full border backdrop-blur-md shadow-sm inline-flex items-center gap-1.5 ${style.bg}`}>
        {style.icon === 'play' ? (
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
        ) : (
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        )}
        {style.label}
      </span>
    </div>

    <!-- Title on image -->
    <div class="absolute bottom-4 left-5 right-5">
      <h4 class="text-white text-lg font-bold leading-tight group-hover:text-blue-200 transition-colors line-clamp-2">
        {title}
      </h4>
    </div>
  </div>

  <div class="p-6 sm:p-7 flex flex-col justify-between flex-1">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-400 mb-3 tracking-wider uppercase">
        {kind === 'video' && videoCount !== undefined ? (
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
            {videoCount} Video Seri
          </span>
        ) : readTime ? (
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            {readTime}
          </span>
        ) : null}
        <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
        <span>{formattedDate}</span>
      </div>

      <p class="text-gray-600 text-sm leading-relaxed mb-6 line-clamp-3 font-normal">
        {description}
      </p>
    </div>

    {tags && tags.length > 0 && (
      <div class="flex gap-2 flex-wrap pt-4 border-t border-gray-100">
        {tags.map((tag) => (
          <span class="px-3 py-0.5 bg-gray-100/70 text-gray-500 rounded-full text-xs font-medium border border-gray-200/50">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
